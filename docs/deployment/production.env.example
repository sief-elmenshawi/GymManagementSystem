# Production environment variables template.
# Copy this file to a secure location, fill the blanks, and keep the filled copy out of git.
# The checker validates names only and never prints values.

ASPNETCORE_ENVIRONMENT=Production

# Required: explicit semicolon-separated host list; the committed wildcard is rejected.
AllowedHosts=gym.example.com;www.gym.example.com

# Required: SQL Server connection string used by the application and startup migrations.
ConnectionStrings__DefaultConnection=

# Required for the first bootstrap only when default admin users should be created.
# Existing user passwords are never reset on later startups.
# Production skips user seeding unless the explicit opt-in below is true.
GYM_SEED_PASSWORD=
# SeedUsers__Password=
# GYM_SEED_USERS_ENABLED=true

# Optional demo/staging data. Keep unset in Production; default is false.
# GYM_SEED_DEMO_DATA=true
# SeedDemoData__Enabled=true

# Required outside Development: configure exactly one AutoMapper license key source.
AUTOMAPPER_LICENSE_KEY=
# LUCKYPENNY_LICENSE_KEY=
# AutoMapper__LicenseKey=

# Required by the deployment checklist: SMTP host for confirmation/reset emails.
Email__Smtp__Host=

# Optional sender address. Runtime default: no-reply@gymmanagement.local.
# Email__From=

# Optional SMTP settings. Runtime defaults are shown; leave commented to use them.
# Email__Smtp__Port=587
# Email__Smtp__UseSsl=true
# Email__Smtp__User=
# Email__Smtp__Password=

# Optional per-IP account endpoint rate limit. Runtime defaults are shown.
# AuthenticationRateLimit__PermitLimit=8
# AuthenticationRateLimit__WindowSeconds=60

# Optional per-user authenticated endpoint rate limit. Runtime defaults are shown.
# AuthenticationRateLimit__AuthenticatedPermitLimit=20
# AuthenticationRateLimit__AuthenticatedWindowSeconds=60

# Required when behind a reverse proxy: trust the proxy IP or CIDR so forwarded
# client IPs and HTTPS schemes are honored. Loopback is trusted by default.
# ForwardedHeaders__KnownProxies__0=127.0.0.1
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
# ForwardedHeaders__ForwardLimit=1

# Never set GYM_TEST_CONNECTION_STRING in production; it is only for local test runs.
