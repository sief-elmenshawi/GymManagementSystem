# Production environment variables template.
# Copy this file to a secure location, fill the blanks, and keep the filled copy out of git.
# The checker validates names only and never prints values.

ASPNETCORE_ENVIRONMENT=Production

# Required: SQL Server connection string used by the application and startup migrations.
ConnectionStrings__DefaultConnection=

# Required for the first bootstrap only when default admin users should be created.
# Existing user passwords are never reset on later startups.
GYM_SEED_PASSWORD=
# SeedUsers__Password=

# Required outside Development: configure exactly one AutoMapper license key source.
AUTOMAPPER_LICENSE_KEY=
# LUCKYPENNY_LICENSE_KEY=
# AutoMapper__LicenseKey=

# Required by the deployment checklist: SMTP host for confirmation/reset emails.
Email__Smtp__Host=

# Optional sender address. Runtime default: no-reply@gymmanagement.local.
# Email__From=

# Optional SMTP settings. Runtime defaults are shown; leave commented to use them.
# Email__Smtp__Port=587
# Email__Smtp__UseSsl=true
# Email__Smtp__User=
# Email__Smtp__Password=

# Never set GYM_TEST_CONNECTION_STRING in production; it is only for local test runs.
