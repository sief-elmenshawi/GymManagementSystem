@using GymManagement.BLL.ViewModels.AnalyticsViewModels
@model AnalyticsViewModel
@{
    ViewData["Title"] = "The studio";
}

<div class="landing">
    <section class="hero shell">
        <div>
            <p class="eyebrow">Route Fitness / Cairo</p>
            <h1 class="hero-title">A gym that<br />remembers<br /><em>your name.</em></h1>
            <p class="hero-lede">
                Coached sessions, open floor time, and a record of what you actually did.
                No sales pitch — just people, weights, and the work.
            </p>
            <div class="hero-actions">
                <a asp-controller="Account" asp-action="Register" class="btn btn-accent">
                    Join the floor <i class="bi bi-arrow-up-right ms-2" aria-hidden="true"></i>
                </a>
                <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline">See the timetable</a>
            </div>
        </div>

        <div class="hero-photo-wrap">
            <div class="photo hero-photo">
                <img src="~/images/hero-squat.jpg"
                     alt="A lifter working through a squat set on the gym floor" />
            </div>
            <div class="hero-photo-secondary">
                <img src="~/images/gym-floor.jpg" alt="Members training together during a session" />
            </div>
        </div>
    </section>

    <div class="shell">
        <dl class="stats-strip">
            <div><dt>On the books</dt><dd>@Model.TotalMembers</dd></div>
            <div><dt>Active now</dt><dd>@Model.ActiveMembers</dd></div>
            <div><dt>Coaches</dt><dd>@Model.TotalTrainers</dd></div>
            <div><dt>Upcoming</dt><dd>@Model.UpcomingSessions</dd></div>
            <div><dt>In progress</dt><dd>@Model.OngoingSessions</dd></div>
            <div><dt>Completed</dt><dd>@Model.CompletedSessions</dd></div>
        </dl>
    </div>

    <section class="section shell">
        <div class="story-grid">
            <div class="story-photos">
                <div class="photo">
                    <img src="~/images/strength-chalk.jpg" alt="Chalked hands gripping a barbell before a lift" />
                </div>
                <div class="photo">
                    <img src="~/images/mobility-stretch.jpg" alt="A member stretching after training" />
                </div>
            </div>

            <div>
                <p class="eyebrow">How we train</p>
                <h2 class="section-title">Simple work,<br />done properly.</h2>
                <p class="section-lede">
                    A membership here is a coach who knows your name, a session that starts on time,
                    and a clear record of every visit. We keep the noise out and the standard high.
                </p>

                <ul class="feature-list">
                    <li>
                        <span class="num">01</span>
                        <div><strong>Coached sessions</strong><span>Small groups, real feedback, no guesswork.</span></div>
                    </li>
                    <li>
                        <span class="num">02</span>
                        <div><strong>Open floor</strong><span>Book a slot, take the space, leave it better than you found it.</span></div>
                    </li>
                    <li>
                        <span class="num">03</span>
                        <div><strong>Progress you can see</strong><span>Your bookings and attendance stay in one place.</span></div>
                    </li>
                </ul>
            </div>
        </div>
    </section>

    <section class="section classes">
        <div class="shell">
            <div class="section-head">
                <div>
                    <p class="eyebrow">On the floor</p>
                    <h2 class="section-title">Three ways to put in work.</h2>
                </div>
                <p class="section-lede">The timetable changes. The standard doesn't.</p>
            </div>

            <div class="class-grid">
                <article class="class-card">
                    <div class="photo">
                        <img src="~/images/strength-chalk.jpg" alt="Barbell setup on the strength floor" />
                    </div>
                    <footer>
                        <span class="num">01 / Strength</span>
                        <h3>Barbell room</h3>
                        <a asp-controller="Sessions" asp-action="Index">View sessions ?</a>
                    </footer>
                </article>
                <article class="class-card">
                    <div class="photo">
                        <img src="~/images/conditioning-row.jpg" alt="A member mid-stroke on a rowing machine" />
                    </div>
                    <footer>
                        <span class="num">02 / Conditioning</span>
                        <h3>Floor circuits</h3>
                        <a asp-controller="Sessions" asp-action="Index">View sessions ?</a>
                    </footer>
                </article>
                <article class="class-card">
                    <div class="photo">
                        <img src="~/images/mobility-stretch.jpg" alt="A member stretching on a gym mat" />
                    </div>
                    <footer>
                        <span class="num">03 / Mobility</span>
                        <h3>Movement lab</h3>
                        <a asp-controller="Sessions" asp-action="Index">View sessions ?</a>
                    </footer>
                </article>
            </div>

            <div class="cta-band">
                <div>
                    <h2>Ready when you are.</h2>
                    <p>Create a member account, confirm your email, then book your first slot.</p>
                </div>
                <a asp-controller="Account" asp-action="Register" class="btn btn-accent">Create account</a>
            </div>
        </div>
    </section>
</div>
