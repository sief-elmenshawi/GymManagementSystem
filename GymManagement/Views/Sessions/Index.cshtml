@model PagedResult<SessionViewModel>
@{
    ViewData["Title"] = "Sessions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show shell">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show shell">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Timetable / staff</p>
            <h1 class="page-title">Training sessions</h1>
            <p>Capacity, coaches, and the floor schedule in one place.</p>
        </div>
        <a asp-controller="Sessions" asp-action="Create" class="btn btn-accent">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add session
        </a>
    </header>

    @if (Model?.Items.Any() == true)
    {
        <div class="row g-4">
            @foreach (var session in Model.Items)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <article class="card h-100 session-card">
                        <div class="card-header py-3">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                <h5 class="mb-0"><i class="bi bi-calendar-event me-2" aria-hidden="true"></i>@session.CategoryName</h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>
                            <div class="session-info">
                                <div class="info-item"><i class="bi bi-person-circle me-2" aria-hidden="true"></i><strong>Coach:</strong> @session.TrainerName</div>
                                <div class="info-item"><i class="bi bi-calendar3 me-2" aria-hidden="true"></i><strong>Date:</strong> @session.DateDisplay</div>
                                <div class="info-item"><i class="bi bi-clock me-2" aria-hidden="true"></i><strong>Time:</strong> @session.TimeRangeDisplay</div>
                                <div class="info-item"><i class="bi bi-hourglass-split me-2" aria-hidden="true"></i><strong>Duration:</strong> @session.Duration</div>
                                <div class="info-item"><i class="bi bi-people me-2" aria-hidden="true"></i><strong>Capacity:</strong> @session.AvailableSlots/@session.Capacity slots</div>
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-outline btn-sm">View details</a>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@session.Id" class="btn btn-outline btn-sm flex-fill">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@session.Id" class="btn btn-outline-danger btn-sm flex-fill">Delete</a>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>

        @await Html.PartialAsync("_Pager", Model.Paging)
    }
    else
    {
        <div class="detail-panel py-5 text-center">
            <i class="bi bi-calendar-x d-block mb-3 text-muted" style="font-size:2.4rem" aria-hidden="true"></i>
            <h2 class="h4">No sessions on the board</h2>
            <p class="text-muted mb-0">Add the first session to open the timetable.</p>
        </div>
    }
</div>

@section Scripts {
    @await Html.PartialAsync("_AlertBoxScript")
}
