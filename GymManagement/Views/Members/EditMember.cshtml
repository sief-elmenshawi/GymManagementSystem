@model MemberToUpdateViewModel
@{
    ViewData["Title"] = "Member Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show shell">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Directory / edit record</p>
            <h1 class="page-title">@Model.Name</h1>
            <p>Update contact details and address for this member.</p>
        </div>
        <a asp-controller="Members" asp-action="Index" class="btn btn-outline">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to List
        </a>
    </header>

    <div class="detail-panel" style="max-width:880px;">
        <form asp-controller="Members" asp-action="EditMember" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="Phone" class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="BuildingNumber" class="form-label">Building Number</label>
                    <input asp-for="BuildingNumber" class="form-control" />
                    <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="City" class="form-label">City</label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Street" class="form-label">Street</label>
                    <input asp-for="Street" class="form-control" />
                    <span asp-validation-for="Street" class="text-danger"></span>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
                <button type="submit" class="btn btn-accent">Done</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertBoxScript" />
}
