@model MemberViewModel
@{
    ViewData["Title"] = "Member Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Directory / member file</p>
            <h1 class="page-title">Member Details</h1>
            <p>Contact record, membership status, and health record access.</p>
        </div>
        <a asp-controller="Members" asp-action="Index" class="btn btn-outline">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to List
        </a>
    </header>

    <div class="detail-grid">
        <section class="detail-panel text-center">
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <img src="@Url.Action("Picture", "Members", new { id = Model.Id })"
                     alt="@Model.Name" class="avatar-fallback mx-auto" style="width:120px;height:120px;" />
            }
            else
            {
                <span class="avatar-fallback mx-auto" style="width:120px;height:120px;font-size:2.6rem" aria-hidden="true">
                    <i class="bi bi-person"></i>
                </span>
            }
            <h2 class="mt-3 mb-1 text-primary-color">@Model.Name</h2>
            <span class="status-pill">@(Model.PlanName ?? "No Active Plans")</span>
            <div class="d-grid gap-2 mt-4">
                <a asp-controller="Members" asp-action="HealthRecordCreate" asp-route-id="@Model.Id"
                   class="btn btn-accent">Add / Edit Health Record</a>
            </div>
        </section>

        <section class="detail-panel">
            <p class="eyebrow">Record</p>
            <dl class="row mb-0">
                <div class="col-12 col-md-6">
                    <dt>Email</dt><dd>@Model.Email</dd>
                </div>
                <div class="col-12 col-md-6">
                    <dt>Phone</dt><dd>@Model.Phone</dd>
                </div>
                <div class="col-12 col-md-6">
                    <dt>Gender</dt><dd>@Model.Gender</dd>
                </div>
                <div class="col-12 col-md-6">
                    <dt>Date of Birth</dt><dd>@Model.DateOfBirth</dd>
                </div>
                @if (Model.PlanName != null)
                {
                    <div class="col-12 col-md-6">
                        <dt>Membership Start Date</dt><dd>@Model.MembershipStartDate</dd>
                    </div>
                    <div class="col-12 col-md-6">
                        <dt>Membership End Date</dt><dd>@Model.MembershipEndDate</dd>
                    </div>
                }
                <div class="col-12">
                    <dt>Address</dt><dd>@Model.Address</dd>
                </div>
            </dl>
        </section>
    </div>
</div>
