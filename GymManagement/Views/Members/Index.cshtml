@model PagedResult<MemberViewModel>
@{
    ViewData["Title"] = "Members";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show shell">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show shell">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Directory / staff</p>
            <h1 class="page-title">Members</h1>
            <p>The people on the floor and their contact records.</p>
        </div>
        <a asp-controller="Members" asp-action="Create" class="btn btn-accent">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add Member
        </a>
    </header>

    @if (Model?.Items.Any() == true)
    {
        <div class="detail-panel">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th><span>@nameof(MemberViewModel.Photo)</span></th>
                            <th><span>@nameof(MemberViewModel.Name)</span></th>
                            <th><span>@nameof(MemberViewModel.Email)</span></th>
                            <th><span>@nameof(MemberViewModel.Gender)</span></th>
                            <th><span>@nameof(MemberViewModel.Phone)</span></th>
                            <th><span>Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var member in Model.Items)
                        {
                            <tr>
                                <td>
                                    @if (member.HasPhoto)
                                    {
                                        <img src="@Url.Action("Picture", "Members", new { id = member.Id })"
                                             alt="@member.Name" class="avatar-fallback" />
                                    }
                                    else
                                    {
                                        <span class="avatar-fallback" aria-hidden="true">
                                            <i class="bi bi-person"></i>
                                        </span>
                                    }
                                </td>
                                <td><span class="fw-bold">@member.Name</span></td>
                                <td><span>@member.Email</span></td>
                                <td><span>@member.Gender</span></td>
                                <td><span>@member.Phone</span></td>
                                <td class="action position-relative">
                                    <div class="dropdown">
                                        <button class="btn btn-link p-0 border-0" type="button"
                                                id="dropdownMenuButton-@member.Id" data-bs-toggle="dropdown"
                                                aria-expanded="false" aria-label="Actions for @member.Name">
                                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-start"
                                            aria-labelledby="dropdownMenuButton-@member.Id">
                                            <li>
                                                <a asp-controller="Members" asp-action="MemberDetails" asp-route-id="@member.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3">
                                                    <i class="bi bi-info-circle text-primary-color" aria-hidden="true"></i>
                                                    <span>View Member Data</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a asp-controller="Members" asp-action="HealthRecordDetails" asp-route-id="@member.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3">
                                                    <i class="bi bi-heart-pulse text-primary-color" aria-hidden="true"></i>
                                                    <span>View Health Record Data</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a asp-controller="Members" asp-action="EditMember" asp-route-id="@member.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3">
                                                    <i class="bi bi-pencil text-primary-color" aria-hidden="true"></i>
                                                    <span>Edit Member Data</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a asp-controller="Members" asp-action="Delete" asp-route-id="@member.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3 text-danger">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @await Html.PartialAsync("_Pager", Model.Paging)
    }
    else
    {
        <div class="detail-panel py-5 text-center">
            <i class="bi bi-person-workspace d-block mb-3 text-muted" style="font-size:2.4rem" aria-hidden="true"></i>
            <h2 class="h4">No Members Available</h2>
            <p class="text-muted mb-0">Add your first member to get started.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertBoxScript" />
}
