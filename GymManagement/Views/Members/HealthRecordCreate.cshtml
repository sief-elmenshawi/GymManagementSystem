@model HealthRecordViewModel
@{
    ViewData["Title"] = "Add Health Record";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var memberId = ViewContext.RouteData.Values["id"];
}

<div class="container mt-5 mb-5">
    <header class="mb-4">
        <h2 class="text-primary-color mb-1">Add Health Record</h2>
        <p class="text-muted mb-0">Member: <strong>@ViewBag.MemberName</strong></p>
    </header>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="HealthRecordCreate" asp-route-id="@memberId" method="post">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Height" class="form-label"></label>
                        <input asp-for="Height" class="form-control" />
                        <span asp-validation-for="Height" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Weight" class="form-label"></label>
                        <input asp-for="Weight" class="form-control" />
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BloodType" class="form-label"></label>
                        <select asp-for="BloodType" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>
                        </select>
                        <span asp-validation-for="BloodType" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note" class="form-control" />
                        <span asp-validation-for="Note" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn bg-primary-color text-white">Save</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
