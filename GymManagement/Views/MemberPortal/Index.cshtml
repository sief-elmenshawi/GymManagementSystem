@model MemberPortalViewModel
@{
    ViewData["Title"] = "My file";
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Member / self service</p>
            <h1 class="page-title">My file</h1>
            <p>My Gym Profile — your membership details and your bookings only.</p>
        </div>
        @if (Model.HasLinkedMember)
        {
            <a asp-controller="MemberPortal" asp-action="Sessions" class="btn btn-accent">
                <i class="bi bi-calendar-plus me-2" aria-hidden="true"></i>Book a session
            </a>
        }
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="alert alert-warning" role="alert">@Model.Notice</div>
    }

    <div class="detail-grid">
        <section class="detail-panel">
            <p class="eyebrow">Member file</p>
            <h2>My Profile</h2>
            <dl>
                <dt>Name</dt>
                <dd>@Model.Name</dd>
                <dt>Email</dt>
                <dd>@Model.Email</dd>
                @if (Model.HasLinkedMember)
                {
                    <dt>Phone</dt>
                    <dd>@Model.Phone</dd>
                    <dt>Date of birth</dt>
                    <dd>@Model.DateOfBirth</dd>
                    <dt>Gender</dt>
                    <dd>@Model.Gender</dd>
                    <dt>Address</dt>
                    <dd>@Model.Address</dd>
                    <dt>Health record</dt>
                    <dd>
                        <span class="status-pill @(Model.HasHealthRecord ? "ok" : "off")">
                            @(Model.HasHealthRecord ? "Recorded" : "Not recorded")
                        </span>
                    </dd>
                }
            </dl>

            @if (Model.HasLinkedMember)
            {
                <a asp-controller="MemberPortal" asp-action="EditProfile" class="btn btn-outline mt-3">
                    <i class="bi bi-pencil me-2" aria-hidden="true"></i>Edit profile
                </a>
            }
        </section>

        <section class="detail-panel">
            <h2>My bookings</h2>
            @if (Model.Bookings.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Session</th>
                                <th>Category</th>
                                <th>Coach</th>
                                <th>Starts</th>
                                <th>Attended</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.Bookings)
                            {
                                <tr>
                                    <td>@booking.Description</td>
                                    <td>@booking.Category</td>
                                    <td>@booking.Trainer</td>
                                    <td>@booking.StartDate</td>
                                    <td>
                                        <span class="status-pill @(booking.IsAttended ? "ok" : "off")">
                                            @(booking.IsAttended ? "Yes" : "No")
                                        </span>
                                    </td>
                                    <td>
                                        @if (booking.CanCancel)
                                        {
                                            <form asp-controller="MemberPortal" asp-action="Cancel" method="post">
                                                <input type="hidden" name="sessionId" value="@booking.SessionId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="py-4 text-center">
                    <i class="bi bi-calendar-x d-block mb-3 text-muted" style="font-size:2.2rem" aria-hidden="true"></i>
                    <p class="text-muted mb-0">No bookings yet.</p>
                </div>
            }
        </section>
    </div>
</div>
