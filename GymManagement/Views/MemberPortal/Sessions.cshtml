@model PagedResult<SessionViewModel>
@{
    ViewData["Title"] = "Book a session";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Member / timetable</p>
            <h1 class="page-title">Book a session</h1>
            <p>Slots with room left. Your booking is always linked to your own profile.</p>
        </div>
        <a asp-controller="MemberPortal" asp-action="Index" class="btn btn-outline">Back to my file</a>
    </header>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="detail-panel">
        @if (Model.Items.Count == 0)
        {
            <div class="py-4 text-center">
                <i class="bi bi-calendar-x d-block mb-3 text-muted" style="font-size:2.2rem" aria-hidden="true"></i>
                <p class="text-muted mb-0">No upcoming sessions are available right now.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Session</th>
                            <th>Category</th>
                            <th>Coach</th>
                            <th>When</th>
                            <th>Available</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model.Items)
                        {
                            <tr>
                                <td>@session.Description</td>
                                <td>@session.CategoryName</td>
                                <td>@session.TrainerName</td>
                                <td>
                                    <div>@session.DateDisplay</div>
                                    <small class="text-muted">@session.TimeRangeDisplay</small>
                                </td>
                                <td>@session.AvailableSlots / @session.Capacity</td>
                                <td>
                                    @if (session.StartDate > DateTime.Now)
                                    {
                                        <form asp-controller="MemberPortal" asp-action="Book" method="post">
                                            <input type="hidden" name="sessionId" value="@session.Id" />
                                            <button type="submit" class="btn btn-sm btn-accent">Book</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="status-pill off">Started</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.Paging.TotalPages > 1)
            {
                <nav class="mt-4" aria-label="Session pages">
                    <ul class="pagination mb-0">
                        <li class="page-item @(Model.Paging.HasPrevious ? "" : "disabled")">
                            @if (Model.Paging.HasPrevious)
                            {
                                <a class="page-link" asp-action="Sessions" asp-route-page="@(Model.Paging.Page - 1)">Previous</a>
                            }
                            else
                            {
                                <span class="page-link">Previous</span>
                            }
                        </li>
                        <li class="page-item disabled"><span class="page-link">Page @Model.Paging.Page of @Model.Paging.TotalPages</span></li>
                        <li class="page-item @(Model.Paging.HasNext ? "" : "disabled")">
                            @if (Model.Paging.HasNext)
                            {
                                <a class="page-link" asp-action="Sessions" asp-route-page="@(Model.Paging.Page + 1)">Next</a>
                            }
                            else
                            {
                                <span class="page-link">Next</span>
                            }
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>
