@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Route Fitness — Reset password</title>
    <link rel="stylesheet" href="~/lib/fonts/google/type.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="auth-shell">
        <section class="auth-panel auth-shell-single w-100">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">Account recovery</p>
            <h1 class="auth-title">A fresh<br /><em>start.</em></h1>
            <p class="auth-subtitle">Choose a new password for <strong>@Model.Email</strong>.</p>

            <form asp-action="ResetPassword" method="post" class="auth-form">
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-2" aria-hidden="true"></i>Reset password</button>
                    <a asp-action="Login" class="btn btn-outline">Back to login</a>
                </div>
            </form>
        </section>

        <aside class="auth-aside">
            <img src="~/images/strength-chalk.jpg" class="auth-photo" alt="Chalked hands ready for a lift" />
            <div class="auth-aside-content">
                <p class="eyebrow">Account access</p>
                <h2>Reset. Return.<br /><span>Repeat.</span></h2>
                <p>Keep the streak going. Your bookings and history stay right where you left them.</p>
            </div>
        </aside>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
