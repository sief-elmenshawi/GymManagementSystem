@{
    ViewData["Title"] = "Check your email";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Route Fitness — Check your email</title>
    <link rel="stylesheet" href="~/lib/fonts/google/type.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="auth-shell">
        <section class="auth-panel auth-shell-single w-100">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">Email confirmation</p>
            <h1 class="auth-title">Check your<br /><em>inbox.</em></h1>
            @if (TempData["SuccessMessage"] is string success)
            {
                <div class="alert alert-success" role="alert">@success</div>
            }
            <p class="auth-subtitle">A fresh confirmation link is on its way. It expires, so use it promptly.</p>
            <a asp-action="Login" class="btn btn-accent">Back to login</a>
        </section>

        <aside class="auth-aside">
            <img src="~/images/gym-floor.jpg" class="auth-photo" alt="Group training session on the gym floor" />
            <div class="auth-aside-content">
                <p class="eyebrow">Membership</p>
                <h2>Confirm, then<br /><span>train.</span></h2>
                <p>One quick step before your account can book a slot on the floor.</p>
            </div>
        </aside>
    </div>
</body>
</html>
