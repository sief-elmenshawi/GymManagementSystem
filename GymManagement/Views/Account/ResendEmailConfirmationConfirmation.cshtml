@{
    ViewData["Title"] = "Check your email";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Check Your Email - Route Fitness</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="card mx-auto shadow-sm border-0 text-center" style="max-width: 480px;">
            <div class="card-body p-4 p-md-5">
                <i class="bi bi-envelope-check fs-1 text-success"></i>
                <h1 class="h4 mt-3 mb-3">Check your email</h1>
                @if (TempData["SuccessMessage"] is not null)
                {
                    <div class="alert alert-success" role="alert">@TempData["SuccessMessage"]</div>
                }
                <p class="text-muted">The link will expire, so use it promptly.</p>
                <a asp-action="Login" class="btn btn-primary">Back to login</a>
            </div>
        </div>
    </div>
</body>
</html>
