@{
    ViewData["Title"] = "Access Denied";
    Layout = null;
}


<style>

    body {
        margin: 0;
        background: linear-gradient(135deg,#071a5a,#1646c8);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Segoe UI',sans-serif;
    }


    .container {
        width: 1000px;
        background: white;
        border-radius: 25px;
        padding: 40px;
        display: flex;
        gap: 40px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }



    .left {
        width: 45%;
        text-align: center;
        padding: 30px;
    }


    .icon {
        font-size: 90px;
        color: #dc2626;
        margin-bottom: 20px;
    }



    h1 {
        color: #222;
        font-size: 35px;
    }


    p {
        color: #666;
        line-height: 1.7;
    }



    .btn {
        display: inline-block;
        margin-top: 30px;
        background: #1d4ed8;
        color: white;
        padding: 15px 50px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: bold;
    }



    .right {
        width: 55%;
    }



    .alert {
        background: #fee2e2;
        border-left: 5px solid #ef4444;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }



    .card {
        border: 1px solid #ddd;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 20px;
    }



        .card h3 {
            color: #123a9c;
        }


    code {
        background: #ede9fe;
        padding: 5px 10px;
        border-radius: 5px;
        color: #6d28d9;
    }

</style>



<div class="container">


    <div class="left">


        <div class="icon">
            🚫
        </div>


        <h1>
            Access Denied
        </h1>


        <p>
            We're sorry, but you don't have permission
            to access this resource.
            Your current role or membership status
            doesn't grant you access.
        </p>



        <p>
            Error Code: <b>403 - Forbidden Access</b>
        </p>



        <a asp-controller="Home"
           asp-action="Index"
           class="btn">

            Return to Home

        </a>


    </div>





    <div class="right">


        <div class="alert">

            <h3>
                🔒 Error 403 — Forbidden Access
            </h3>


            <p>
                The user is authenticated,
                but their role doesn't grant access
                to this resource.
            </p>

        </div>




        <div class="card">

            <h3>
                🔐 Why this page exists
            </h3>


            <p>

                When using:

                <br />

                <code>
                    [Authorize(Roles="SuperAdmin")]
                </code>

                <br /><br />

                Identity checks the user's role.
                If the role doesn't match,
                this page is displayed.

            </p>


        </div>





        <div class="card">


            <h3>
                VS Different from Login redirect
            </h3>


            <p>
                ❌ Not signed in →
                <code>/Account/Login</code>
            </p>


            <p>
                🚫 Wrong role →
                <code>/Account/AccessDenied</code>
            </p>


        </div>



    </div>


</div>