@{
    ViewData["Title"] = "Access denied";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f4ed" />
    <title>Route Fitness — Access denied</title>
    <link rel="stylesheet" href="~/lib/fonts/google/type.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <div class="auth-shell">
        <section class="auth-panel auth-shell-single w-100">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">403 / Forbidden</p>
            <h1 class="auth-title">Not this<br /><em>door.</em></h1>
            <p class="auth-subtitle">
                Your account doesn't have access to this part of the studio. If you think that's
                a mistake, ask the administrator to review your role.
            </p>

            <div class="auth-note mono">Error code: 403 — Forbidden access</div>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <a asp-action="Index" asp-controller="Home" class="btn btn-accent">Return to the studio</a>
                <a asp-action="Login" asp-controller="Account" class="btn btn-outline">Switch account</a>
            </div>
        </section>

        <aside class="auth-aside">
            <img src="~/images/hero-squat.jpg" class="auth-photo" alt="A member training on the gym floor" />
            <div class="auth-aside-content">
                <p class="eyebrow">Membership access</p>
                <h2>Every role<br />has its <span>place.</span></h2>
                <p>Members see their own record. Staff see the floor. Nothing more, nothing less.</p>
            </div>
        </aside>
    </div>
</body>
</html>
