@model ResendEmailConfirmationViewModel
@{
    ViewData["Title"] = "Resend confirmation email";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="auth-shell">
        <section class="auth-panel auth-shell-single w-100">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">Email confirmation</p>
            <h1 class="auth-title">One more<br /><em>email.</em></h1>
            <p class="auth-subtitle">Enter your address and we'll send a fresh confirmation link.</p>

            <form asp-action="ResendEmailConfirmation" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-accent"><i class="bi bi-send me-2" aria-hidden="true"></i>Send confirmation link</button>
                    <a asp-action="Login" class="btn btn-outline">Back to login</a>
                </div>
            </form>
        </section>

        <aside class="auth-aside">
            <img src="~/images/gym-floor.jpg" class="auth-photo" alt="Members training together on the gym floor" />
            <div class="auth-aside-content">
                <p class="eyebrow">Membership</p>
                <h2>Confirm, then<br /><span>train.</span></h2>
                <p>One quick step before your account can book a slot on the floor.</p>
            </div>
        </aside>
    </div>
