@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="auth-shell">
        <section class="auth-panel auth-shell-single w-100">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">Account recovery</p>
            <h1 class="auth-title">Forgot your password?</h1>
            <p class="auth-subtitle">We'll email a secure reset link. It expires, so use it promptly.</p>

            <form asp-action="ForgotPassword" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-accent"><i class="bi bi-send me-2" aria-hidden="true"></i>Send reset link</button>
                    <a asp-action="Login" class="btn btn-outline">Back to login</a>
                </div>
            </form>
        </section>

        <aside class="auth-aside">
            <img src="~/images/mobility-stretch.jpg" class="auth-photo" alt="A member taking a break after training" />
            <div class="auth-aside-content">
                <p class="eyebrow">Account access</p>
                <h2>Back on the<br /><span>floor.</span></h2>
                <p>One link, one new password, then you're back to the timetable.</p>
            </div>
        </aside>
    </div>
