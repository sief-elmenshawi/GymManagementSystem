@model ConfirmEmailViewModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email confirmed" : "Confirmation failed";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Route Fitness</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="card mx-auto shadow-sm border-0 text-center" style="max-width: 480px;">
            <div class="card-body p-4 p-md-5">
                @if (Model.Succeeded)
                {
                    <i class="bi bi-envelope-check fs-1 text-success"></i>
                }
                else
                {
                    <i class="bi bi-exclamation-triangle fs-1 text-warning"></i>
                }

                <h1 class="h4 mt-3 mb-3">@ViewData["Title"]</h1>
                <p class="text-muted">@Model.Message</p>
                <a asp-action="Login" class="btn btn-primary">Go to login</a>
            </div>
        </div>
    </div>
</body>
</html>
