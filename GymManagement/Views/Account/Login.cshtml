@using GymManagement.BLL.ViewModels.ApplicationViewModels
@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="auth-shell">
        <section class="auth-panel">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">Account access</p>
            <h1 class="auth-title">Welcome<br /><em>back.</em></h1>
            <p class="auth-subtitle">Sign in to manage the timetable, members, or your own record.</p>

            <form asp-action="Login" asp-controller="Account" method="post" id="loginForm" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                @if (TempData["SuccessMessage"] is string success)
                {
                    <div class="alert alert-success" role="alert">@success</div>
                }
                @Html.ValidationMessage("InvalidLogin", new { @class = "text-danger d-block mb-3 small" })

                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" id="floatingEmail"
                           placeholder="name@example.com" autocomplete="username" />
                    <label for="floatingEmail">Email address</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Password" class="form-control" id="floatingPassword"
                           placeholder="Password" autocomplete="current-password" />
                    <label for="floatingPassword">Password</label>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="auth-row">
                    <div class="form-check mb-0">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Keep me signed in</label>
                    </div>
                    <a asp-action="ResendEmailConfirmation" asp-controller="Account">Resend confirmation</a>
                </div>

                <div class="auth-row mt-0">
                    <a asp-action="ForgotPassword" asp-controller="Account">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-accent w-100 mt-2" id="loginBtn">
                    Sign in <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                </button>
            </form>

            <p class="text-muted mt-4 mb-0 small">
                New here?
                <a asp-action="Register" asp-controller="Account" class="text-primary-color fw-bold text-decoration-none">Create a member account</a>
            </p>
        </section>

        <aside class="auth-aside">
            <img src="~/images/auth-team.jpg" class="auth-photo" alt="Two members training with weights on the gym floor" />
            <div class="auth-aside-content">
                <p class="eyebrow">Route Fitness / since 2019</p>
                <h2>Train hard.<br />Leave a <span>record.</span></h2>
                <p>The timetable, the coaches, your bookings, and your history — all in one place.</p>
                <div class="auth-meta">
                    <div>Floor<strong>06 days</strong></div>
                    <div>Groups<strong>Small</strong></div>
                    <div>Records<strong>Live</strong></div>
                </div>
            </div>
        </aside>
    </div>

@section Scripts {
    <script>
        $(function () {
            $('#loginForm').on('submit', function () {
                if ($(this).valid()) {
                    const button = document.getElementById('loginBtn');
                    button.classList.add('disabled');
                    button.disabled = true;
                    button.setAttribute('aria-busy', 'true');
                }
            });
        });
    </script>
}
