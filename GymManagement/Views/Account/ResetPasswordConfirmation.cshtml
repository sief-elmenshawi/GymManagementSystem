@{
    ViewData["Title"] = "Password reset";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}
<div class="auth-shell">
        <section class="auth-panel auth-shell-single w-100">
            <a class="auth-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-symbol" aria-hidden="true">RF</span>
                <span class="brand-text">Route Fitness<small>Training studio</small></span>
            </a>

            <p class="eyebrow">Account recovery</p>
            <h1 class="auth-title">All set.<br /><em>Sign in.</em></h1>
            <p class="auth-subtitle">Your password has been reset. You can now sign in with the new one.</p>
            <a asp-action="Login" class="btn btn-accent">Go to login</a>
        </section>

        <aside class="auth-aside">
            <img src="~/images/strength-chalk.jpg" class="auth-photo" alt="Barbell and chalk on the gym floor" />
            <div class="auth-aside-content">
                <p class="eyebrow">Account access</p>
                <h2>Back to the<br /><span>floor.</span></h2>
                <p>Everything else stayed the same — your record, your bookings, your coach.</p>
            </div>
        </aside>
    </div>
