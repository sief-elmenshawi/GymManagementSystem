@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Something went wrong</p>
            <h1 class="page-title">Error.</h1>
            <p>An error occurred while processing your request.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-accent">
            <i class="bi bi-house me-2" aria-hidden="true"></i>Back to the studio
        </a>
    </header>

    <div class="detail-panel">
        @if (Model.ShowRequestId)
        {
            <p class="eyebrow">Request ID</p>
            <p class="mono mb-4">@Model.RequestId</p>
        }
        <p class="text-muted mb-0">
            If the problem continues, note the request ID and ask an administrator to check the logs.
        </p>
    </div>
</div>
