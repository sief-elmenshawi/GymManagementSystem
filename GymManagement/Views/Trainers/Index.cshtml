@model PagedResult<TrainerViewModel>
@{
    ViewData["Title"] = "Trainers";
}

@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show shell">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show shell">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Coaching / staff</p>
            <h1 class="page-title">Our Trainers</h1>
            <p>Professional fitness instructors and their specialties.</p>
        </div>
        <a asp-controller="Trainers" asp-action="Create" class="btn btn-accent">
            <i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Add Trainer
        </a>
    </header>

    @if (Model?.Items.Count > 0)
    {
        <div class="detail-panel">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th><span>Name</span></th>
                            <th><span>Email</span></th>
                            <th><span>Phone</span></th>
                            <th><span>Specialization</span></th>
                            <th><span>Action</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in Model.Items)
                        {
                            <tr>
                                <td><span class="fw-bold">@trainer.Name</span></td>
                                <td><span>@trainer.Email</span></td>
                                <td><span>@trainer.Phone</span></td>
                                <td><span class="status-pill">@trainer.Specialties</span></td>
                                <td class="action position-relative">
                                    <div class="dropdown">
                                        <button class="btn btn-link p-0 border-0" type="button"
                                                id="dropdownMenuButton-@trainer.Id" data-bs-toggle="dropdown"
                                                aria-expanded="false" aria-label="Actions for @trainer.Name">
                                            <i class="bi bi-three-dots" aria-hidden="true"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-start"
                                            aria-labelledby="dropdownMenuButton-@trainer.Id">
                                            <li>
                                                <a asp-controller="Trainers" asp-action="Details" asp-route-id="@trainer.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3">
                                                    <i class="bi bi-eye text-primary-color" aria-hidden="true"></i>
                                                    <span>View Details</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a asp-controller="Trainers" asp-action="Edit" asp-route-id="@trainer.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3">
                                                    <i class="bi bi-pencil text-primary-color" aria-hidden="true"></i>
                                                    <span>Edit Details</span>
                                                </a>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a asp-controller="Trainers" asp-action="Delete" asp-route-id="@trainer.Id"
                                                   class="dropdown-item d-flex align-items-center gap-3 text-danger">
                                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </a>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pager", Model.Paging)
    }
    else
    {
        <div class="detail-panel py-5 text-center">
            <i class="bi bi-person-workspace d-block mb-3 text-muted" style="font-size:2.4rem" aria-hidden="true"></i>
            <h2 class="h4">No Trainers Available</h2>
            <p class="text-muted mb-0">Add your first trainer to get started.</p>
        </div>
    }
</div>

@section Scripts {
    <partial name="_AlertBoxScript" />
}
