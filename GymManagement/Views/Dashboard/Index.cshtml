@using GymManagement.BLL.ViewModels.AnalyticsViewModels
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Super Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <header class="bg-primary-color text-white rounded-3 p-4 shadow-sm mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h2 class="mb-1 fw-semibold">Super Admin Dashboard</h2>
                <p class="mb-0 text-light opacity-75">Overview and management shortcuts</p>
            </div>
            <a asp-action="Index" asp-controller="Home" class="btn btn-light">
                <i class="bi bi-bar-chart me-1"></i> View Analytics
            </a>
        </div>
    </header>

    <h4 class="mb-3">Overview</h4>
    <div class="row g-3 mb-5">
        <div class="col-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <span class="fw-bolder fs-3 d-block mb-1 text-primary-color">@Model.TotalMembers</span>
                    <h3 class="fs-6 fw-normal text-muted mb-0">Total Members</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <span class="fw-bolder fs-3 d-block mb-1 text-primary-color">@Model.ActiveMembers</span>
                    <h3 class="fs-6 fw-normal text-muted mb-0">Active Members</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <span class="fw-bolder fs-3 d-block mb-1 text-primary-color">@Model.TotalTrainers</span>
                    <h3 class="fs-6 fw-normal text-muted mb-0">Trainers</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <span class="fw-bolder fs-3 d-block mb-1 text-primary-color">@Model.UpcomingSessions</span>
                    <h3 class="fs-6 fw-normal text-muted mb-0">Upcoming Sessions</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <span class="fw-bolder fs-3 d-block mb-1 text-primary-color">@Model.OngoingSessions</span>
                    <h3 class="fs-6 fw-normal text-muted mb-0">Ongoing Sessions</h3>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <span class="fw-bolder fs-3 d-block mb-1 text-primary-color">@Model.CompletedSessions</span>
                    <h3 class="fs-6 fw-normal text-muted mb-0">Completed Sessions</h3>
                </div>
            </div>
        </div>
    </div>

    <h4 class="mb-3">Manage</h4>
    <div class="row g-3">
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Members" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-people-fill fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Members</h5>
                        <p class="text-muted mb-0">Create, edit, and manage members</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Trainers" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-person-badge fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Trainers</h5>
                        <p class="text-muted mb-0">Manage trainer profiles and specialties</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Sessions" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-calendar-event fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Sessions</h5>
                        <p class="text-muted mb-0">Plan schedules, capacity, and trainers</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Plans" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-card-checklist fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Plans</h5>
                        <p class="text-muted mb-0">Configure membership plans and prices</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Membership" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-patch-check fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Memberships</h5>
                        <p class="text-muted mb-0">Review and cancel active memberships</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Booking" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-journal-check fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Session Schedule</h5>
                        <p class="text-muted mb-0">Manage bookings and attendance</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-12 col-md-6 col-lg-4">
            <a asp-action="Index" asp-controller="Users" class="text-decoration-none">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <i class="bi bi-shield-lock fs-3 text-primary-color"></i>
                        <h5 class="mt-3 mb-1">Users & Roles</h5>
                        <p class="text-muted mb-0">Create accounts and assign roles</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>
