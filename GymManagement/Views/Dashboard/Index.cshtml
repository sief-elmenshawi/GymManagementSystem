@using GymManagement.BLL.ViewModels.AnalyticsViewModels
@model AnalyticsViewModel
@{
    ViewData["Title"] = "Overview";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Control room / 01 — Super Admin Dashboard</p>
            <h1 class="page-title">Operations overview</h1>
            <p>The same live figures the floor sees, plus the tools to change them.</p>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline">
            <i class="bi bi-graph-up me-2" aria-hidden="true"></i>View analytics
        </a>
    </header>

    <p class="eyebrow">Live figures</p>
    <div class="metric-grid">
        <div class="metric"><span class="index">01</span><strong>@Model.TotalMembers</strong><span>Total Members</span></div>
        <div class="metric"><span class="index">02</span><strong>@Model.ActiveMembers</strong><span>Active members</span></div>
        <div class="metric"><span class="index">03</span><strong>@Model.TotalTrainers</strong><span>Trainers</span></div>
        <div class="metric"><span class="index">04</span><strong>@Model.UpcomingSessions</strong><span>Upcoming sessions</span></div>
        <div class="metric"><span class="index">05</span><strong>@Model.OngoingSessions</strong><span>Ongoing sessions</span></div>
        <div class="metric"><span class="index">06</span><strong>@Model.CompletedSessions</strong><span>Completed sessions</span></div>
    </div>

    <p class="eyebrow">Manage</p>
    <div class="link-grid">
        <a asp-action="Index" asp-controller="Members" class="link-tile">
            <span class="index">01</span><h3>Members</h3>
            <p>Create, edit, and manage the people on the floor.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a asp-action="Index" asp-controller="Trainers" class="link-tile">
            <span class="index">02</span><h3>Trainers</h3>
            <p>Profiles, specialties, and who leads each session.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a asp-action="Index" asp-controller="Sessions" class="link-tile">
            <span class="index">03</span><h3>Sessions</h3>
            <p>Timetable, capacity, and trainer assignments.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a asp-action="Index" asp-controller="Plans" class="link-tile">
            <span class="index">04</span><h3>Plans</h3>
            <p>Membership types and pricing on the books.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a asp-action="Index" asp-controller="Membership" class="link-tile">
            <span class="index">05</span><h3>Memberships</h3>
            <p>Active records, renewals, and cancellations.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a asp-action="Index" asp-controller="Booking" class="link-tile">
            <span class="index">06</span><h3>Schedule</h3>
            <p>Bookings and attendance for every session.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a asp-action="Index" asp-controller="Users" class="link-tile">
            <span class="index">07</span><h3>Users &amp; roles</h3>
            <p>Accounts and access for the team.</p>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
    </div>
</div>
