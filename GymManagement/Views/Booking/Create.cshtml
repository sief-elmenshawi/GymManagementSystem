@model CreateBookingViewModel
@{
    ViewData["Title"] = "Create Booking";
}

<div class="shell">
    <header class="page-head">
        <div>
            <p class="kicker">Schedule / new booking</p>
            <h1 class="page-title">Create New Booking</h1>
            <p>Add a member to this session's roster.</p>
        </div>
        <a asp-action="GetMembersForUpcomingSession" asp-route-id="@ViewContext.RouteData.Values["id"]"
           class="btn btn-outline">
            <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to List
        </a>
    </header>

    <div class="detail-panel" style="max-width:720px;">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="SessionId" value="@ViewContext.RouteData.Values["id"]" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <label asp-for="MemberId" class="form-label">Member</label>
            <select asp-for="MemberId" asp-items="ViewBag.Members" class="form-select">
                <option value="">-- Select Member --</option>
            </select>
            <span asp-validation-for="MemberId" class="text-danger"></span>

            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-accent">
                    <i class="bi bi-check2 me-2" aria-hidden="true"></i>Create Booking
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
